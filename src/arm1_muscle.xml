<mujoco model="arm1_muscle">
  <!-- 1-joint arm, 2 Hill muscles (agonist/antagonist). Isolates DoF=1 in the SAME custom
       framework as arm2/arm3, to test whether the frozen>co-learned effect vanishing at
       1-DoF is about DoF (vs MyoSuite-specific). -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>
  <default>
    <joint type="hinge" axis="0 0 1" damping="0.2" limited="true"/>
    <geom type="capsule" size="0.03" rgba="0.7 0.7 0.75 1" density="800"/>
    <site size="0.012" rgba="0.9 0.3 0.3 1"/>
    <muscle ctrllimited="true" ctrlrange="0 1"/>
    <tendon width="0.008" rgba="0.9 0.5 0.4 1"/>
  </default>
  <worldbody>
    <light pos="0 0 2"/>
    <geom name="floor" type="plane" pos="0 0 -1" size="2 2 0.1" rgba="0.3 0.3 0.35 1"/>
    <site name="s_up"   pos="0 0.08 0"/>
    <site name="s_down" pos="0 -0.08 0"/>
    <body name="upper" pos="0 0 0">
      <joint name="shoulder" range="-2.0 2.0"/>
      <geom fromto="0 0 0 0.25 0 0"/>
      <site name="u_up"   pos="0.05 0.05 0"/>
      <site name="u_down" pos="0.05 -0.05 0"/>
      <site name="tip" pos="0.25 0 0" size="0.02" rgba="0.2 0.8 0.3 1"/>
    </body>
    <body name="target" mocap="true" pos="0.2 0.15 0">
      <site name="target_site" pos="0 0 0" size="0.025" rgba="0.2 0.4 0.9 0.6"/>
    </body>
  </worldbody>
  <tendon>
    <spatial name="t_sh_flex"><site site="s_up"/><site site="u_up"/></spatial>
    <spatial name="t_sh_ext"> <site site="s_down"/><site site="u_down"/></spatial>
  </tendon>
  <actuator>
    <muscle name="sh_flex" tendon="t_sh_flex"/>
    <muscle name="sh_ext"  tendon="t_sh_ext"/>
  </actuator>
</mujoco>
