<mujoco model="arm4_muscle">
  <!-- 4-joint arm, 10 Hill muscles (8 monoarticular + 2 biarticular). Extends the DoF axis
       (arm1..arm4) to characterise how the frozen>co-learned advantage scales with DoF. -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>
  <default>
    <joint type="hinge" axis="0 0 1" damping="0.25" limited="true"/>
    <geom type="capsule" size="0.026" rgba="0.7 0.7 0.75 1" density="800"/>
    <site size="0.010" rgba="0.9 0.3 0.3 1"/>
    <muscle ctrllimited="true" ctrlrange="0 1"/>
    <tendon width="0.006" rgba="0.9 0.5 0.4 1"/>
  </default>
  <worldbody>
    <light pos="0 0 2"/>
    <geom name="floor" type="plane" pos="0 0 -1" size="2 2 0.1" rgba="0.3 0.3 0.35 1"/>
    <site name="w_up"   pos="0 0.07 0"/>
    <site name="w_down" pos="0 -0.07 0"/>
    <site name="w_bi1"  pos="0 0.09 0"/>
    <body name="upper" pos="0 0 0">
      <joint name="shoulder" range="-2.0 2.0"/>
      <geom fromto="0 0 0 0.22 0 0"/>
      <site name="u_up"   pos="0.05 0.05 0"/><site name="u_down" pos="0.05 -0.05 0"/>
      <site name="ue_up"  pos="0.18 0.05 0"/><site name="ue_down" pos="0.18 -0.05 0"/>
      <site name="u_bi2"  pos="0.06 0.06 0"/>
      <body name="fore" pos="0.22 0 0">
        <joint name="elbow" range="-2.5 0.2"/>
        <geom fromto="0 0 0 0.20 0 0"/>
        <site name="f_up"   pos="0.05 0.045 0"/><site name="f_down" pos="0.05 -0.045 0"/>
        <site name="fw_up"  pos="0.15 0.045 0"/><site name="fw_down" pos="0.15 -0.045 0"/>
        <site name="f_bi1"  pos="0.05 0.05 0"/>
        <body name="hand" pos="0.20 0 0">
          <joint name="wrist" range="-1.6 1.6"/>
          <geom fromto="0 0 0 0.15 0 0"/>
          <site name="h_up"   pos="0.04 0.04 0"/><site name="h_down" pos="0.04 -0.04 0"/>
          <site name="hg_up"  pos="0.11 0.04 0"/><site name="hg_down" pos="0.11 -0.04 0"/>
          <site name="h_bi2"  pos="0.05 0.05 0"/>
          <body name="hand2" pos="0.15 0 0">
            <joint name="wrist2" range="-1.6 1.6"/>
            <geom fromto="0 0 0 0.12 0 0"/>
            <site name="g_up"   pos="0.04 0.035 0"/><site name="g_down" pos="0.04 -0.035 0"/>
            <site name="tip" pos="0.12 0 0" size="0.018" rgba="0.2 0.8 0.3 1"/>
          </body>
        </body>
      </body>
    </body>
    <body name="target" mocap="true" pos="0.4 0.2 0">
      <site name="target_site" pos="0 0 0" size="0.022" rgba="0.2 0.4 0.9 0.6"/>
    </body>
  </worldbody>
  <tendon>
    <spatial name="t_sh_flex"><site site="w_up"/><site site="u_up"/></spatial>
    <spatial name="t_sh_ext"> <site site="w_down"/><site site="u_down"/></spatial>
    <spatial name="t_el_flex"><site site="ue_up"/><site site="f_up"/></spatial>
    <spatial name="t_el_ext"> <site site="ue_down"/><site site="f_down"/></spatial>
    <spatial name="t_wr_flex"><site site="fw_up"/><site site="h_up"/></spatial>
    <spatial name="t_wr_ext"> <site site="fw_down"/><site site="h_down"/></spatial>
    <spatial name="t_w2_flex"><site site="hg_up"/><site site="g_up"/></spatial>
    <spatial name="t_w2_ext"> <site site="hg_down"/><site site="g_down"/></spatial>
    <spatial name="t_bi1"><site site="w_bi1"/><site site="u_up"/><site site="f_bi1"/></spatial>
    <spatial name="t_bi2"><site site="u_bi2"/><site site="fw_up"/><site site="h_bi2"/></spatial>
  </tendon>
  <actuator>
    <muscle name="sh_flex" tendon="t_sh_flex"/><muscle name="sh_ext" tendon="t_sh_ext"/>
    <muscle name="el_flex" tendon="t_el_flex"/><muscle name="el_ext" tendon="t_el_ext"/>
    <muscle name="wr_flex" tendon="t_wr_flex"/><muscle name="wr_ext" tendon="t_wr_ext"/>
    <muscle name="w2_flex" tendon="t_w2_flex"/><muscle name="w2_ext" tendon="t_w2_ext"/>
    <muscle name="bi_shel" tendon="t_bi1"/><muscle name="bi_elwr" tendon="t_bi2"/>
  </actuator>
</mujoco>
